[init]
	defaultBranch = main

[user]
	name  = Kenneth Sabalo
	email = kendfss@disroot.org
	useconfigonly = true
	signingkey = 30D23C55F4873469


[alias]
	ignore  = update-index --assume-unchanged
	accept  = update-index --no-assume-unchanged
	ignored = !git ls-files -v | grep "^[[:lower:]]"
	lg      = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%C(bold blue)<%an>%Creset' --abbrev-commit
	rs      = reset HEAD~1 --soft
	restage = reset HEAD~1 --soft


[core]
	editor       = hx
	excludesfile = ~/.gitignore
	pager        = delta

[color "status"]
	changed   = yellow bold
	added     = green 
	untracked = red 

[http]
	cookiefile = ~/.gitcookies

[credential]
	helper = store


[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true

[merge]
	conflictStyle = zdiff3
[gpg]
	format = openpgp
[commit]
	gpgsign = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
