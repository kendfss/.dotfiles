#!/bin/env python

import readline
import math
import os
import sys
from math import perm as perms, comb as combs
from itertools import permutations as perm, combinations as comb, product as prod, chain
from functools import reduce
from fnmatch import fnmatch


def powerset(iterable, fn=comb):
    "Subsequences of the iterable from shortest to longest."
    # powerset([1,2,3]) → () (1,) (2,) (3,) (1,2) (1,3) (2,3) (1,2,3)
    s = list(iterable)
    return chain.from_iterable(fn(s, r) for r in range(len(s) + 1))


def show(x):
    return [None, *map(print, x)][0]


def add(a, b):
    return a + b


def sub(a, b):
    return a - b


def mul(a, b):
    return a * b


def div(a, b):
    return a / b


def mod(a, b):
    return a % b


def source(*args):
    import inspect

    for arg in args:
        code = arg.__code__
        print(
            f"{code.co_filename}:{code.co_firstlineno}\n{'\n'.join(map(lambda x: '    ' + x, inspect.getsource(arg).splitlines()))}",
        )


