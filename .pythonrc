#!/bin/env python

import math
import os
import subprocess
import sys

from fnmatch import fnmatch
from functools import reduce
from itertools import permutations as perm, combinations as comb, product as prod, chain
from math import perm as perms, comb as combs

from _pyrepl.simple_interact import _get_reader
import pyperclip as pc
import pyrepl_hacks as repl


@repl.register_command("delete-whole-line")
def ctrl_u_to_end_then_kill(reader):
    """Move to the end of the line, then delete to the beginning."""
    repl.commands.end_of_line(reader, "", "")
    repl.commands.unix_line_discard(reader, "", "")


repl.bind("Ctrl+U", "delete-whole-line")
reader = _get_reader()
reader.bind(r"\e[1;3D", "backward-word")
reader.bind(r"\e[1;3C", "forward-word")


def powerset(iterable, fn=comb):
    "Subsequences of the iterable from shortest to longest."
    # powerset([1,2,3]) → () (1,) (2,) (3,) (1,2) (1,3) (2,3) (1,2,3)
    s = list(iterable)
    return chain.from_iterable(fn(s, r) for r in range(len(s) + 1))


def nest(outer, inner):
    def out(x):
        return outer(inner(x))

    return out


def f(x):
    return f"{x:,}"


def show(x):
    return [None, *map(print, x)][0]


def add(a, b):
    return a + b


def sub(a, b):
    return a - b


def mul(a, b):
    return a * b


def div(a, b):
    return a / b


def mod(a, b):
    return a % b


def source(*args):
    import inspect

    for arg in args:
        code = arg.__code__
        body = "\n".join(map(lambda x: "    " + x, inspect.getsource(arg).splitlines()))
        print(
            f"{code.co_filename}:{code.co_firstlineno}\n{body}",
        )


if __name__ != "__main__":

    def _():
        show(
            add,
            mul,
            div,
            mod,
            sub,
            math,
            os,
            sys,
            perms,
            combs,
            reduce,
            prod,
            perm,
            comb,
        )
