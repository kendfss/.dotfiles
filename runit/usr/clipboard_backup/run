#!/bin/sh

set -e

exec 2>&1

self="$(realpath "$0")"
owner="$(stat -c %U "$self")"

. "$(dirname "$self")/utils.sh"

export DISPLAY="${DISPLAY:-:0}"
export XAUTHORITY="${XAUTHORITY:-/run/user/$(id -u "$owner")/lyxauth}"

mkdir -p "$CLIPBOARD_BACKUP_FOLDER"

old_clipboard="$(xclip -o -selection clipboard)"
old_primary="$(xclip -o -selection primary)"
[ -n "$old_clipboard" ] && writeToFile clipboard
[ -n "$old_primary" ] && writeToFile primary

# just in case writes become slow, we keep them in a separate loop
while clipnotify; do
	new_clipboard="$(xclip -o -selection clipboard)"
	[ -n "$new_clipboard" ] && [ "$new_clipboard" != "$old_clipboard" ] && writeToFile clipboard "$new_clipboard"
	new_primary="$(xclip -o -selection primary)"
	[ -n "$new_primary" ] && [ "$new_primary" != "$old_primary" ] && writeToFile primary "$new_primary"
done
