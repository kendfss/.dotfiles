#!/bin/env zsh

# play some music via mpv

set -euo pipefail

file="$(realpath "$ZSH_ARGZERO")"
folder="$(dirname "$file")"
self="$(basename "$file")"

source "$folder/utils.sh"

help() {
	cat <<-eof
		usage: $self [flag]... [arg]...

		traverse a directory and play music from it

		flags:
		    -h, --help              print this message and exit
		    -c, --count             report the number of files found
		    -l, --list              list files
		    -n, --number            only play a given number of files
		    -s, --shuffle           shuffle found songs
		    -v, --verbose           verbose output from mpv
	eof
}

local verbose
local shuffle
local number
local list=false
local count=false

local dirs=()
local files=()

while (($#)); do
	case "$1" in
		--help | -h*) help 0 ;;
		-n | --number) number="$2" ;;
		-v | --verbose) verbose='-v' && set -x ;;
		-s | --shuffle) shuffle='--shuffle' ;;
		-c | --count) count=true ;;
		-l | --list) list=true ;;
		*.(wav|mp3|flac|aac|m4a|ogg|opus|aiff|aif))
			files+=("$(realpath "$1")")
			;;
		-n*) number="${1#-n}" ;;
		-v*) verbose="-v" && set -x ;;
		-s*) shuffle='--shuffle' ;;
		-c*) count=true && argv[1]="-${1#-c}" && continue ;;
		-l*) list=true && argv[1]="-${1#-l}" && continue ;;
		-*) fatal "unrecognized flag: '$1'" ;;
		*) dirs+=("$(realpath "$1")") ;;
	esac
	shift
done

! $list || {
	exts **
	exit 0
}

if [ 0 = ${#files[@]} ] && [ 0 = ${#dirs[@]} ]; then
	dirs=(${(@s;:;)PLAYPATH})
fi

for dir in "${dirs[@]}"; do
	dir="$(realpath "$dir")"
	# Single find command for all files recursively
	while IFS= read -r -d '' file; do
		files+=("$file")
	done < <(fd -0utf "\.(wav|mp3|flac|aac|m4a|ogg|opus|aiff|aif)$" "$dir")
	# done < <(find "$dir" -type f \( -iname "*.flac" -o -iname "*.mp3" -o -iname "*.m4a" -o -iname "*.ogg" -o -iname "*.opus" -o -iname "*.wav" -o -iname "*.aif" -o -iname "*.aiff" \) -print0 2>/dev/null)
done

! $count || {
	echo ${#files[@]}
	exit 0
}

[ ${#files[@]} -eq 0 ] && echo no files found >&2 && return 1

if [ -z "$number" ]; then
	mpv $verbose --no-resume-playback --no-audio-display $shuffle -- "${files[@]}"
else
	[ -n "$number" ] || head() { cat; }
	$shuffle || alias shuf=cat
	printf '%s\n' ${files[@]} | shuf | head -$number | xargs -d '\n' mpv $verbose --no-resume-playback --no-audio-display
fi
