#!/usr/bin/env bash

RECORDING_DIR="${SCREEN_RECORDINGS:-$HOME/rec}"
mkdir -p "$RECORDING_DIR"

cleanup() {
	echo "Cleaning up..."
	if [[ -f /tmp/recpid ]]; then
		kill -TERM "$(cat /tmp/recpid)" 2>/dev/null || true
		rm -f /tmp/recpid
	fi
	if [[ -f /tmp/audpid ]]; then
		kill -TERM "$(cat /tmp/audpid)" 2>/dev/null || true
		rm -f /tmp/audpid
	fi
	rm -f /tmp/recordingicon
	exit 0
}

trap cleanup SIGINT SIGTERM EXIT

record() {
	amixer set Capture toggle >/dev/null 2>&1

	DIMENSIONS="$(xdpyinfo | awk '/dimensions/{print $2}')"
	TIMESTAMP="$(date '+%a__%b%d__%H_%M_%S')"

	# Record video
	ffmpeg -s "$DIMENSIONS" -f x11grab -r 30 -i :0.0 -c:v h264 -qp 0 "$RECORDING_DIR/video_$TIMESTAMP.mkv" &
	echo $! >/tmp/recpid

	# Record audio
	ffmpeg -f alsa -i default -af "afftdn=nf=-75" "$RECORDING_DIR/audio_$TIMESTAMP.wav" &
	echo $! >/tmp/audpid

	# Xfce notification
	notify-send -t 2000 -i media-record "Recording Started" "Screen recording is now active (mic toggled)"
}

end() {
	if [[ -f /tmp/recpid ]]; then
		local recpid=$(cat /tmp/recpid)
		if kill -0 "$recpid" 2>/dev/null; then
			kill -TERM "$recpid"
		fi
		rm -f /tmp/recpid
	fi

	if [[ -f /tmp/audpid ]]; then
		local audpid=$(cat /tmp/audpid)
		if kill -0 "$audpid" 2>/dev/null; then
			kill -TERM "$audpid"
		fi
		rm -f /tmp/audpid
	fi

	amixer set Capture toggle >/dev/null 2>&1

	# Xfce notification
	notify-send -t 2000 -i media-record "Recording Ended" "Recording saved to $RECORDING_DIR"
}

# Toggle recording
if [[ -f /tmp/recpid ]] && kill -0 "$(cat /tmp/recpid)" 2>/dev/null; then
	end
else
	record
fi
